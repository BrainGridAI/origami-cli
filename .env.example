# Copy to .env and fill in, or export these in your shell / CI.
# An API key from Settings → Developers in the Origami app (https://origami.chat).
# Keys look like: og_live_...
ORIGAMI_API_KEY=

# Optional overrides
# ORIGAMI_PROJECT=<project-id>          # scope requests to a project (child org)
# ORIGAMI_BASE_URL=https://origami.chat/api/v2
# ORIGAMI_PROFILE=default
# ORIGAMI_CONFIG_DIR=~/.config/origami
