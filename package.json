{
  "name": "@braingrid/origami-cli",
  "version": "0.2.0",
  "description": "The command line for the Origami API: every v3 operation (send, leads, jobs, account) as a command, generated from the published spec.",
  "type": "module",
  "license": "MIT",
  "author": "BrainGrid (https://www.braingrid.ai)",
  "homepage": "https://github.com/BrainGridAI/origami-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrainGridAI/origami-cli.git"
  },
  "bugs": {
    "url": "https://github.com/BrainGridAI/origami-cli/issues"
  },
  "keywords": [
    "origami",
    "origami.chat",
    "cli",
    "api",
    "agents",
    "leads",
    "enrichment",
    "outreach",
    "campaigns",
    "linkedin",
    "sales",
    "openapi"
  ],
  "bin": {
    "origami": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync:v3": "node scripts/sync-v3-catalog.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
